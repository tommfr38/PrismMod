{
  "schemaVersion": 1,
  "id": "prismmod",
  "version": "${version}",
  "name": "Prism",
  "description": "Adds the Prism and the legendary Prism Sword — 25 attack damage, 64 swings, and locked behind the Ender Dragon. Craft Prism's Power to launch yourself off it like a firework.",
  "authors": [
    "Tomi"
  ],
  "license": "MIT",
  "icon": "assets/prismmod/icon.png",
  "environment": "*",
  "mixins": [
    "prismmod.mixins.json"
  ],
  "entrypoints": {
    "client": [
      "net.tomi.prismmod.client.PrismModClient"
    ],
    "main": [
      "net.tomi.prismmod.PrismMod"
    ]
  },
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": "~${minecraft_version}",
    "java": ">=25",
    "fabric-api": "*"
  }
}
